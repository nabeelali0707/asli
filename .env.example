# ── Database ── leave DATABASE_URL empty to use embedded PGlite (real Postgres in WASM)
DATABASE_URL=
ASLI_DB=file            # file | memory (PGlite only)
ASLI_DB_DIR=.data/pglite

# ── Auth ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=28800

# ── AI ── all optional. Without keys Asli runs deterministic fallbacks and says so in every trace.
ASLI_AI_MODE=live       # live | offline
ANTHROPIC_API_KEY=      # Claude: extraction, document reading, policy answers
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=         # Google AI Studio free tier: extraction, document reading, policy answers (used when no Anthropic key)
GEMINI_MODEL=gemini-2.5-flash
AI_GATEWAY_API_KEY=     # Jev via Vercel AI Gateway (preferred)
OPENROUTER_API_KEY=     # Jev via OpenRouter (alternative)
JEV_MODEL=typesafe-ai/jev
GROQ_API_KEY=           # Whisper (whisper-large-v3) for Urdu speech-to-text
OPENAI_API_KEY=         # or OpenAI whisper-1

# ── Signed Truth ── Ed25519 PEM keys (npm run keys:generate). Dev auto-generates and stores one.
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=

CRON_SECRET=            # protects POST /api/v1/jobs/run
PUBLIC_BASE_URL=http://localhost:3000

# ── Demo ── one-tap sign-in on /login for the fictional demo accounts. NEVER enable in a real deployment.
ASLI_DEMO_MODE=true
